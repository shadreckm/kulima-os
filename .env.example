# Kulima OS Environment Configuration

# API Configuration
APP_NAME=Kulima OS API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///./kulima_os.db
DATABASE_ECHO=False

# Security
API_KEY=your-api-key-change-in-production
SECRET_KEY=your-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# File Storage
ARTIFACTS_DIR=./artifacts

# WhatsApp Integration
WHATSAPP_WEBHOOK_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Logging
LOG_LEVEL=INFO
